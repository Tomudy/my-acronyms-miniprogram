/* 搜索结果页样式 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg, #F4F4F1);
}

/* ---------------- 顶部固定区 ---------------- */
.header {
  flex: none;
  background: var(--surface, #FFFFFF);
  padding: 18rpx 24rpx 14rpx;
  border-bottom: 1rpx solid var(--line, #E3E7EB);
}

.search-row {
  display: flex;
  align-items: center;
}

/* 搜索框 */
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 76rpx;
  background: var(--surface-2, #FAFAF8);
  border: 1rpx solid var(--line, #E3E7EB);
  border-radius: 100rpx;
  padding: 0 20rpx;
}
.ico-search {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #9AA0A8;
  border-radius: 50%;
  flex: none;
  margin-right: 16rpx;
}
.ico-search::after {
  content: '';
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 4rpx;
  background: #9AA0A8;
  border-radius: 4rpx;
  transform: rotate(45deg);
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1F2329;
  height: 76rpx;
}
.search-ph {
  color: #B4BAC4;
  font-size: 27rpx;
}
.ico-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #C9CED6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-left: 12rpx;
}
.ico-clear-hover {
  background: #AEB5BF;
}
.ico-clear-in {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}
.ico-clear-in::before,
.ico-clear-in::after {
  content: '';
  position: absolute;
  top: 9rpx;
  left: 0;
  width: 20rpx;
  height: 3rpx;
  background: #FFFFFF;
  border-radius: 3rpx;
}
.ico-clear-in::before { transform: rotate(45deg); }
.ico-clear-in::after { transform: rotate(-45deg); }

.cancel {
  flex: none;
  font-size: 28rpx;
  color: var(--accent, #31597E);
  padding: 0 8rpx 0 20rpx;
  line-height: 76rpx;
}
.cancel-hover {
  color: var(--accent-deep, #234260);
}

/* 统计 + 排序同一行 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.sorts {
  display: flex;
  align-items: center;
  background: var(--surface-2, #FAFAF8);
  border: 1rpx solid var(--line, #E3E7EB);
  border-radius: 100rpx;
  padding: 4rpx;
}

/* 统计行 */
.meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9AA0A8;
}
.meta-num {
  color: var(--accent, #31597E);
  font-weight: 600;
  font-size: 24rpx;
}
.meta-txt { margin-left: 6rpx; }
.meta-dot { margin: 0 10rpx; }

/* ---------------- 滚动列表 ---------------- */
.list-wrap {
  flex: 1 1 0%;
  min-height: 0;
  overflow: hidden;
}
.list {
  padding-top: 20rpx;
  padding-bottom: 60rpx;
}

.card-item {
  display: flex;
  align-items: flex-start;
}
.card-body {
  flex: 1;
  min-width: 0;
}
.row-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.abbr {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink, #1C2530);
  letter-spacing: 1rpx;
  margin-right: 14rpx;
  line-height: 1.2;
}
.full {
  display: block;
  font-size: 25rpx;
  color: var(--ink-2, #4C5A6B);
  line-height: 1.45;
  word-break: break-all;
}
.zh {
  display: block;
  font-size: 28rpx;
  color: var(--ink, #1C2530);
  margin-top: 6rpx;
  line-height: 1.45;
  word-break: break-all;
}
.row-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3, #93A0AF);
}
.foot-dot {
  margin: 0 10rpx;
}

/* 收藏按钮 */
.fav {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  border-radius: 50%;
  transition: background 0.15s ease;
}
.fav-hover {
  background: var(--surface-2, #FAFAF8);
}
.fav-star {
  font-size: 40rpx;
  color: var(--line-strong, #C9D0D8);
  line-height: 1;
}
.fav-on .fav-star {
  color: #FFB020;
}
