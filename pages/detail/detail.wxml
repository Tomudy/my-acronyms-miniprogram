<!-- 详情页：查看 / 新增 / 编辑 -->
<view class="page">

  <!-- 顶部栏（新增 / 编辑模式）：左上角「取消」返回上一页 -->
  <view wx:if="{{canEdit}}" class="topbar">
    <view class="nav-back" hover-class="nav-back-hover" bindtap="onCancel">
      <view class="chev"></view>
      <text class="nav-back-text">取消</text>
    </view>
    <text class="topbar-title">{{navTitle}}</text>
    <view class="topbar-side"></view>
  </view>

  <!-- 头部：大缩写 + 行业 + 来源 -->
  <view class="hero">
    <view class="hero-row">
      <text class="hero-abbr">{{abbr || '新词条'}}</text>
      <text class="badge badge-industry">{{industryName}}</text>
      <text class="badge {{sourceClass}}">{{sourceText}}</text>
    </view>
    <text class="hero-full">{{full || '填写英文原词'}}</text>
    <text class="hero-zh">{{zh || '填写中文释义'}}</text>

    <view class="hero-actions">
      <view
        class="fav-btn {{fav ? 'fav-on' : ''}}"
        hover-class="fav-btn-hover"
        bindtap="onToggleFav"
      >
        <text class="fav-btn-star">{{fav ? '★' : '☆'}}</text>
        <text class="fav-btn-text">{{fav ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
  </view>

  <!-- 只读提示（内置词条） -->
  <view wx:if="{{isBuiltin}}" class="tip">
    <text class="tip-text">内置词条为只读，不能编辑或删除；需要的话可以新增一条自己的词条。</text>
  </view>

  <!-- 说明（只读模式下有内容才展示） -->
  <view wx:if="{{!canEdit && note}}" class="hero-note">
    <text class="hero-note-text">{{note}}</text>
  </view>

  <!-- 表单 -->
  <view class="section">
    <text class="section-title">词条内容</text>

    <view class="field {{isBuiltin ? 'field-locked' : ''}}">
      <text class="field-label">缩写</text>
      <input
        class="field-input"
        value="{{abbr}}"
        bindinput="onAbbrInput"
        placeholder="例如 API"
        placeholder-class="field-ph"
        disabled="{{isBuiltin}}"
        maxlength="40"
      />
    </view>

    <view class="field {{isBuiltin ? 'field-locked' : ''}}">
      <text class="field-label">英文原词</text>
      <textarea
        class="field-textarea"
        value="{{full}}"
        bindinput="onFullInput"
        placeholder="例如 Application Programming Interface"
        placeholder-class="field-ph"
        disabled="{{isBuiltin}}"
        maxlength="200"
        auto-height
      />
    </view>

    <view class="field {{isBuiltin ? 'field-locked' : ''}}">
      <text class="field-label">中文释义</text>
      <textarea
        class="field-textarea"
        value="{{zh}}"
        bindinput="onZhInput"
        placeholder="例如 应用程序编程接口"
        placeholder-class="field-ph"
        disabled="{{isBuiltin}}"
        maxlength="200"
        auto-height
      />
    </view>

    <!-- 行业 / 场景：可编辑时用胶囊单选，这是「同一缩写多含义」的唯一键之一 -->
    <view wx:if="{{canEdit}}" class="field">
      <text class="field-label">行业 / 场景<text class="field-hint">（换行业可再存一条含义）</text></text>
      <scroll-view class="chips-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="chips">
          <view
            wx:for="{{industryOptions}}"
            wx:key="key"
            class="chip {{item.key === industry ? 'chip-on' : ''}}"
            hover-class="chip-hover"
            data-key="{{item.key}}"
            bindtap="onIndustryPick"
          >{{item.name}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="field {{isBuiltin ? 'field-locked' : ''}}">
      <text class="field-label">创建者<text class="field-hint">（点一下填入微信昵称）</text></text>
      <!-- type="nickname"：微信官方「头像昵称填写能力」。
           点输入框会拉起微信面板填入本人昵称；拿不到时留空，保存后兜底为「匿名用户」。
           平台已回收 getUserProfile/getUserInfo，无法静默读取昵称，这是唯一合规途径。 -->
      <input
        class="field-input"
        type="nickname"
        value="{{creator}}"
        bindinput="onCreatorInput"
        placeholder="点击填写微信昵称"
        placeholder-class="field-ph"
        disabled="{{isBuiltin}}"
        maxlength="20"
      />
    </view>

    <!-- 说明：可选，补充说明这个含义的用法与边界 -->
    <view wx:if="{{canEdit}}" class="field">
      <text class="field-label">说明<text class="field-hint">（选填，用法 / 例外）</text></text>
      <textarea
        class="field-textarea"
        value="{{note}}"
        bindinput="onNoteInput"
        placeholder="例如：财务口径的 ROI 按年化计算"
        placeholder-class="field-ph"
        maxlength="200"
        auto-height
      />
    </view>

    <!-- 来源 / 出处：可选。字段名不能叫 source —— 那个已被「内置 / 自定义」占用 -->
    <view wx:if="{{canEdit}}" class="field">
      <text class="field-label">来源 / 出处<text class="field-hint">（选填）</text></text>
      <input
        class="field-input"
        value="{{sourceRef}}"
        bindinput="onRefInput"
        placeholder="例如：公司术语表 v2.1"
        placeholder-class="field-ph"
        maxlength="60"
      />
    </view>
  </view>

  <!-- 同一个缩写的其他含义 -->
  <view wx:if="{{others.length > 0}}" class="section">
    <text class="section-title">「{{abbr}}」还有 {{others.length}} 个含义</text>
    <view class="meaning-list">
      <view
        wx:for="{{others}}"
        wx:key="id"
        class="meaning-item"
        hover-class="card-hover"
        data-id="{{item.id}}"
        bindtap="onOtherTap"
      >
        <view class="meaning-top">
          <text class="badge badge-industry">{{item.industryText}}</text>
          <text class="badge {{item.sourceText === '内置' ? 'badge-builtin' : 'badge-custom'}}">{{item.sourceText}}</text>
        </view>
        <text class="meaning-full">{{item.full}}</text>
        <text class="meaning-zh">{{item.zh}}</text>
      </view>
    </view>
  </view>

  <!-- 元信息 -->
  <view class="section">
    <text class="section-title">记录信息</text>
    <view class="meta-card">
      <view class="meta-line">
        <text class="meta-key">来源</text>
        <text class="meta-val">{{sourceText}}</text>
      </view>
      <view class="meta-line">
        <text class="meta-key">行业 / 场景</text>
        <text class="meta-val">{{industryName}}</text>
      </view>
      <view wx:if="{{sourceRef}}" class="meta-line">
        <text class="meta-key">来源 / 出处</text>
        <text class="meta-val">{{sourceRef}}</text>
      </view>
      <view class="meta-line">
        <text class="meta-key">创建时间</text>
        <text class="meta-val">{{createdAt || '保存后自动生成'}}</text>
      </view>
      <view class="meta-line">
        <text class="meta-key">修改时间</text>
        <text class="meta-val">{{updatedAt || '保存后自动生成'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="footer">
    <view
      wx:if="{{canEdit}}"
      class="btn btn-danger footer-del"
      hover-class="btn-hover"
      bindtap="onDelete"
    >删除</view>
    <view
      wx:if="{{canEdit}}"
      class="btn btn-primary footer-save"
      hover-class="btn-hover"
      bindtap="onSave"
    >{{isNew ? '添加词条' : '保存修改'}}</view>
    <view
      wx:if="{{!canEdit}}"
      class="btn btn-ghost footer-full"
      hover-class="btn-hover"
      bindtap="onToggleFav"
    >{{fav ? '取消收藏' : '收藏这条'}}</view>
  </view>

</view>
